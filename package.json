{
  "name": "ai-task-manager-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "backend"
  ],
  "scripts": {
    "build": "npm run build:desktop",
    "start:desktop": "concurrently -n \"BACKEND,DESKTOP\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:desktop\"",
    "dev:desktop": "npm run dev --workspace=apps/desktop",
    "build:desktop": "npm run build --workspace=apps/desktop",
    "bundle:desktop": "npm run build:backend && npm run build:desktop",
    "dev:backend": "npm run dev --workspace=backend",
    "build:backend": "npm run build --workspace=backend",
    "check-types": "tsc --noEmit"
  },

  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
